<!-- ===================== WEEK 6 — OGUN ===================== -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <title>SGI Ilekes Mini Course — Week 6 (Ogun)</title>
  <meta name="description" content="Week 6: Ogun ileke — green and black. Meaning, ethics, care, permissions, and weekly reflection." />
  <style>
    :root{--bg:#0b0b0f;--ink:#f3f4f6;--muted:#bfc3d1;--card:rgba(20,20,28,.92);--border:rgba(255,255,255,.12);--accent:#bb66ff;--ring:rgba(187,102,255,.35);--radius:18px;--shadow:0 18px 60px rgba(0,0,0,.45);--max:1100px;}
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(900px 520px at 20% -10%, rgba(187,102,255,.22), transparent 55%),radial-gradient(900px 520px at 90% 10%, rgba(255,209,102,.18), transparent 55%),var(--bg);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif;}
    a{color:inherit}
    .wrap{max-width:var(--max);margin:0 auto;padding:22px 18px 60px;}
    header{border:1px solid var(--border);background:linear-gradient(180deg, rgba(20,20,28,.96), rgba(20,20,28,.84));border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);}
    .top{display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap}
    h1{margin:0;font-size:22px}
    .sub{color:var(--muted);margin-top:6px;max-width:820px}
    .btn{display:inline-flex;gap:8px;align-items:center;text-decoration:none;border:1px solid rgba(187,102,255,.55);background:linear-gradient(180deg, rgba(187,102,255,.22), rgba(187,102,255,.10));padding:10px 12px;border-radius:14px;font-weight:800;box-shadow:0 14px 30px rgba(0,0,0,.35);}
    .btn.secondary{border-color:rgba(255,255,255,.16);background:rgba(255,255,255,.04);color:var(--muted);font-weight:700;}
    .grid{display:grid;grid-template-columns:1.25fr .95fr;gap:14px;margin-top:14px}
    .card{border:1px solid var(--border);background:linear-gradient(180deg, rgba(20,20,28,.92), rgba(20,20,28,.78));border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);}
    .kicker{display:inline-flex;gap:8px;align-items:center;font-size:12px;letter-spacing:.28px;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
    .kicker .line{width:28px;height:1px;background:rgba(255,255,255,.18)}
    .heroimg{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:16px;border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.04)}
    .note{border:1px dashed rgba(255,255,255,.18);background:rgba(255,255,255,.03);padding:12px;border-radius:14px;color:var(--muted);margin-top:12px}
    .note strong{color:var(--ink)}
    .check{display:flex;gap:10px;align-items:flex-start;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.03);border-radius:14px;padding:12px;margin-top:10px}
    .check input{margin-top:3px;width:18px;height:18px;accent-color:var(--accent)}
    label{font-size:13px;color:var(--muted)}
    input[type="text"], textarea{width:100%;padding:11px 12px;border-radius:14px;border:1px solid rgba(255,255,255,.14);background:rgba(11,11,15,.55);color:var(--ink);outline:none}
    textarea{min-height:120px;resize:vertical}
    input:focus, textarea:focus{border-color:rgba(187,102,255,.55);box-shadow:0 0 0 6px var(--ring)}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .small{font-size:12px;color:var(--muted)}
    @media(max-width:980px){.grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="top">
        <div>
          <h1>Week 6 — Ògún / Ogun — Ileke Study</h1>
          <div class="sub">Focus: discipline, work, tools, integrity, and clean effort.</div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn secondary" href="week-5-shango.html">← Prev</a>
          <a class="btn secondary" href="index.html">Course Index</a>
          <a class="btn" href="week-7-oya.html">Next →</a>
        </div>
      </div>
    </header>

    <div class="grid">
      <main class="card">
        <div class="kicker"><span class="line"></span> Ileke of the Week <span class="line"></span></div>
        <img class="heroimg" src="ogun-ileke.png" alt="Ogun ileke green and black beads" />
        <div class="note">
          <strong>Typical colors:</strong> Green & Black.<br>
          <strong>Core function:</strong> iron, work, discipline, cutting through obstacles.
        </div>

        <div class="kicker" style="margin-top:16px"><span class="line"></span> Study Prompts <span class="line"></span></div>
        <ul style="color:var(--muted);padding-left:18px;margin:0">
          <li>What is one “tool” you need to sharpen (skill, routine, mindset)?</li>
          <li>Where are you inconsistent—what would discipline change?</li>
          <li>How do you cut obstacles without harming people unnecessarily?</li>
        </ul>

        <div class="kicker" style="margin-top:16px"><span class="line"></span> Weekly Reflection <span class="line"></span></div>
        <form onsubmit="return false;" style="display:grid;gap:10px;margin-top:8px">
          <div class="row">
            <div><label for="student">Student Name</label><input id="student" type="text" placeholder="Your name" autocomplete="name" /></div>
            <div><label for="date">Date</label><input id="date" type="text" placeholder="YYYY-MM-DD" /></div>
          </div>
          <div><label for="q1">1) What is your primary “work” for this season of life?</label><textarea id="q1"></textarea></div>
          <div><label for="q2">2) What daily discipline will you practice for 7 days?</label><textarea id="q2"></textarea></div>
          <div><label for="q3">3) What is your ethical rule for using power/tools?</label><textarea id="q3"></textarea></div>
          <div class="row">
            <a class="btn" href="#" onclick="downloadReflection('Week6_Ogun');return false;">Download Reflection (.txt)</a>
            <a class="btn secondary" href="#" onclick="copyReflection();return false;">Copy</a>
          </div>
        </form>
      </main>

      <aside class="card">
        <div class="kicker"><span class="line"></span> Self-Check <span class="line"></span></div>
        <div class="check"><input type="checkbox"><div><b>I can identify the colors</b><div class="small">Green & Black</div></div></div>
        <div class="check"><input type="checkbox"><div><b>I can explain function</b><div class="small">Work, iron, discipline</div></div></div>
        <div class="check"><input type="checkbox"><div><b>I can state the ethics</b><div class="small">Integrity; no reckless cutting</div></div></div>
        <div class="note"><strong>Care reminder:</strong> keep away from disrespectful spaces; store with order and cleanliness.</div>
        <a class="btn secondary" href="ogun-ileke.png" target="_blank" rel="noopener" download style="justify-content:center;margin-top:10px">Open/Download Ileke Image</a>
      </aside>
    </div>
  </div>

  <script>
    (function(){const d=new Date();const p=n=>String(n).padStart(2,"0");const iso=d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate());const el=document.getElementById("date");if(el&&!el.value) el.value=iso;})();
    function buildReflectionText(){
      const name=(document.getElementById("student")?.value||"").trim();
      const date=(document.getElementById("date")?.value||"").trim();
      const q1=(document.getElementById("q1")?.value||"").trim();
      const q2=(document.getElementById("q2")?.value||"").trim();
      const q3=(document.getElementById("q3")?.value||"").trim();
      return [
        "SGI — Ilekes Mini Course — Week 6 (Ogun) Reflection",
        "--------------------------------------------------",
        `Student: ${name||"________________________"}`,
        `Date: ${date||"________________________"}`,
        "",
        "1) What is your primary “work” for this season of life?",
        q1||"[Write your answer here...]",
        "",
        "2) What daily discipline will you practice for 7 days?",
        q2||"[Write your answer here...]",
        "",
        "3) What is your ethical rule for using power/tools?",
        q3||"[Write your answer here...]",
        "",
        "Declaration: I acknowledge ilekes are consecrated tools that require authorization and lineage respect.",
        ""
      ].join("\n");
    }
    function downloadReflection(prefix){
      const text=buildReflectionText();
      const blob=new Blob([text],{type:"text/plain;charset=utf-8"});
      const url=URL.createObjectURL(blob);
      const a=document.createElement("a");
      a.href=url;
      a.download=`SGI_Ilekes_${prefix}_Reflection.txt`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(()=>URL.revokeObjectURL(url),800);
    }
    async function copyReflection(){
      const text=buildReflectionText();
      try{ await navigator.clipboard.writeText(text); alert("Copied."); }
      catch(e){ const ta=document.createElement("textarea"); ta.value=text; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); alert("Copied."); }
    }
  </script>
</body>
</html>
